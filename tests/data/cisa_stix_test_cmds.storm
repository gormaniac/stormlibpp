$x="https://www.cisa.gov/sites/default/files/2024-02/MAR-10448362.c1.v1.CLEAR_stix2.json"
$resp=$lib.inet.http.get($x)
$bundle = $lib.json.load($resp.body)
$confresp=$lib.inet.http.get("https://raw.githubusercontent.com/gormaniac/stormlibpp/main/data/stix_import_conf.json")
if ($confresp.code != 200) { $lib.exit(`Unable to download custom STIX config: HTTP {$confresp.code}`) }
$c=$lib.json.load($confresp.body)
$lib.print($lib.json.save($c))
yield $lib.stix.import.ingest($bundle, config=$c)
$lib.print($bundle)