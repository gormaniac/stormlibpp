function id_from_bundle(bun, obj_id) {
    for $obj in $bun.objects {
        if ($obj.id = $obj_id) {
            return ($obj)
        }
    }
}

function find_resolves(refs) {
    for $ref in $refs {
        $resolves_obj = $id_from_bundle($bundle, $ref)
        switch $resolves_obj.type {
            ipv4-addr: { [ inet:dns:a=($object.value, $resolves_obj.value) ] }
            ipv6-addr: { [ inet:dns:aaaa=($object.value, $resolves_obj.value) ] }
            domain-name: { [ inet:dns:cname=($object.value, $resolves_obj.value) ] }
        }
        [ <(refs)+ { it:sec:stix:bundle:id=$bundle.id } ]
        | spin
    }
    fini { return() }
}

[inet:fqdn=$object.value]

if $object.resolves_to_refs {
    { $find_resolves($object.resolves_to_refs) }
}

[ <(refs)+ { it:sec:stix:bundle:id=$bundle.id } ]
$node.data.set(`stix:object:bundle:{$bundle.id}`, $object)
return($node)