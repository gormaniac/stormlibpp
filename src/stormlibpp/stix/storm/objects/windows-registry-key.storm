/*
Example Stix 2.1 "windows-registry-key" object:
{
    "type": "windows-registry-key",
    "spec_version": "2.1",
    "id": "windows-registry-key--2ba37ae7-2745-5082-9dfd-9486dad41016",
    "key": "hkey_local_machine\\system\\bar\\foo",
    "values": [
        { "name": "Foo", "data": "qwerty", "data_type": "REG_SZ" }
    ]
}

Stix allows one key with multiple values, but it:dev:regval
models a single key+value pair per node, so this creates one node per entry
in "values" (or a single key-only node if "values" is empty/unset). Only the
last node created is returned/tracked by the ingest engine - a known
limitation of the one-node-per-object ingest model for this Stix type.
*/
if $object.values {
    // NOTE: intentionally NOT wrapped in a `{ }` subquery here (unlike the
    // usual loop convention elsewhere in this repo) - a subquery isolates
    // its pipeline from the outer one, which would prevent the created node
    // from ever binding to $node for the final return($node) below. Verified
    // against a live Cortex: wrapping this in `{ }` silently drops the node.
    for $regval in $object.values {
        [ it:dev:regval=(stix, windows-registry-key, $object.id, $regval.name)
            :key?=$object.key
            :str?=$regval.data
        ]
        [ <(refs)+ { it:sec:stix:bundle:id=$bundle.id } ]
        $node.data.set(`stix:object:bundle:{$bundle.id}`, $object)
    }
} else {
    [ it:dev:regval=(stix, windows-registry-key, $object.id)
        :key?=$object.key
    ]
    [ <(refs)+ { it:sec:stix:bundle:id=$bundle.id } ]
    $node.data.set(`stix:object:bundle:{$bundle.id}`, $object)
}
return($node)