/*
Example Stix 2.1 "infrastructure" object:
{
    "type": "infrastructure",
    "spec_version": "2.1",
    "id": "infrastructure--38c47d93-d984-4fd9-b87b-d69463f22740",
    "created": "2016-05-12T08:17:27.000Z",
    "modified": "2016-05-12T08:17:27.000Z",
    "name": "Poison Ivy C2",
    "description": "Poison Ivy C2 server hosting infrastructure used by the threat actor.",
    "infrastructure_types": ["command-and-control"],
    "first_seen": "2016-01-01T00:00:00.000Z",
    "last_seen": "2016-04-01T00:00:00.000Z"
}

Mapped to it:host, as for system identities. Infrastructure types are tags;
the complete original object is retained in node data.
*/
[ it:host=(stix, infrastructure, $object.id)
    :name?=$object.name
    .seen?=$object.first_seen
    .seen?=$object.last_seen
]
{ for $itype in $object.infrastructure_types {
    $tag = `stix.infra.{$itype}`
    [ +#$tag ]
} }
[ <(refs)+ { it:sec:stix:bundle:id=$bundle.id } ]
$node.data.set(`stix:object:bundle:{$bundle.id}`, $object)
return($node)