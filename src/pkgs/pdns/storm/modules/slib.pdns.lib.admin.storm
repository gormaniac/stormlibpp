// Admin APIs for slib.pdns. Runs asroot, gated by the slib.pdns.admin perm.

$userKey = "slib:pdns:auth:user"
$passKey = "slib:pdns:auth:passwd"

// Save the CIRCL Passive DNS credentials (HTTP Basic auth) that every slib.pdns request uses.
function setAuth(user, passwd) {
    if ($user = '' or $passwd = '') {
        $lib.raise(BadArg, "slib.pdns.admin.key requires a username and a password, or --clear.")
    }
    $lib.globals.set($userKey, $user)
    $lib.globals.set($passKey, $passwd)
}

// Remove the saved CIRCL Passive DNS credentials.
function clearAuth() {
    $lib.globals.pop($userKey)
    $lib.globals.pop($passKey)
}
