init {
    $adminlib = $lib.import(slib.pdns.lib.admin)
}

// This takes no inbound nodes.
| spin |

if $cmdopts.clear {
    $adminlib.clearAuth()
    $lib.print("Removed the CIRCL Passive DNS credentials.")
} else {
    $adminlib.setAuth($cmdopts.username, $cmdopts.password)
    $lib.print("Saved the CIRCL Passive DNS credentials.")
}
