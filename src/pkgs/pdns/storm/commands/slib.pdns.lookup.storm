init {
    $pdnslib = $lib.import(slib.pdns.lib)
    $queryOpt = $cmdopts.query

    // Empty strings and 0 mean "not set", the lib takes null.
    $rrtype = (null)
    if $cmdopts.rrtype { $rrtype = $cmdopts.rrtype }
    $pagesize = (null)
    if ($cmdopts.page_size > 0) { $pagesize = $cmdopts.page_size }
    $active = (not $cmdopts.no_active)
    $maxpages = $cmdopts.max_pages
}

// Use the value in --query if it is passed. This branch must not reference $node at all -
// that would make it non-runtsafe and the command would never run without inbound nodes.
if ($queryOpt != '') {
    // We spin when --query is used because this isn't meant to accept inbound nodes.
    | spin |

    divert $cmdopts.yield $pdnslib.lookup($queryOpt, rrtype=$rrtype, active=$active, pagesize=$pagesize, maxpages=$maxpages)
}
else {
    switch $node.form() {
        "inet:fqdn": { $query = $node.value() }
        // repr() not value() - CIRCL needs the printable address, not inet:ipv4's int.
        "inet:ipv4": { $query = $node.repr() }
        "inet:ipv6": { $query = $node.repr() }
        *: { $query = (null) }
    }

    if ($query = null) {
        $lib.warn(`The node form "{$node.form()}" is not supported by the slib.pdns.lookup command.`)
    } else {
        divert $cmdopts.yield $pdnslib.lookup($query, rrtype=$rrtype, active=$active, pagesize=$pagesize, maxpages=$maxpages)
    }
}
