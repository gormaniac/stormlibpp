// Privileged (asroot) code for slib.ipapi: the ip-api.com requests, their rate limiting, the
// global API key, and reads of the tag settings. slib.ipapi.user users need no perms on the
// globals or vaults used here.
//
// Every function here can be called by a slib.ipapi.user, a leading "_" doesn't make one
// private. So no function returns the global API key, and it's only read in query() and
// queryBatch(), whose request paths are fixed: a caller controlled path could send the key to
// another host (ex. "@evil.example/" makes "https://pro.ip-api.com@evil.example/?key=...").
//
// NOTE: $lib.globals.get/set are the only global var APIs in Synapse 2.x, this package
// requires Synapse <3.0.0 (see synapse_version), so R005 is ignored here.

// The free endpoints (no API key, plain HTTP only, non-commercial use only) and the pro
// endpoints (API key, HTTPS, no rate limit). slib:ipapi:url overrides both, ex. for tests.
$freeUrl = "http://ip-api.com"
$proUrl = "https://pro.ip-api.com"

// The fields requested from ip-api.com, for both the /json and /batch endpoints.
$fields = "status,message,country,countryCode,region,regionName,city,lat,lon,isp,org,as,asname,reverse,mobile,proxy,hosting,query"

// The most IPs ip-api.com accepts in one /batch request.
$batchSize = (100)

// Seconds to wait if ip-api.com rate limits a request without a usable X-Ttl header.
$defaultTtl = (60)

// How many times a request is retried after an HTTP 429 before it fails.
$maxRetries = (3)

// The total time, in seconds, one ip-api.com request may take.
$timeout = (30)

// The vault type for ip-api.com pro API keys, global (admins) and user scoped (each user).
$vaultType = "ipapi"

// The tag prefix to use for ip-api.com's hosting/mobile/proxy results, or (null) if tags
// are disabled. Raises BadConfValu if tags are enabled but the prefix is unset or invalid.
function getIpApiTag() {
    $tagEnabled = $lib.globals.get("slib:ipapi:tag:enabled")  // noqa: R005
    if (not $tagEnabled) { return() }

    $tagPrefix = $lib.globals.get("slib:ipapi:tag:prefix")  // noqa: R005
    if ($tagPrefix = null) {
        $lib.raise(BadConfValu, "The slib.ipapi tag prefix is not set. Please set it with the slib.ipapi.admin.settag command.")
    }

    ($ok, $norm) = $lib.trycast(syn:tag, $tagPrefix)
    if (not $ok) {
        $lib.raise(BadConfValu, `The slib.ipapi tag prefix "{$tagPrefix}" is not a valid tag. Please set it with the slib.ipapi.admin.settag command.`)
    }

    return($norm)
}

// A decimal digit string as an int (leading zeros are fine).
function _dec(text) {
    $text = $text.lstrip("0")
    if (not $text) { return((0)) }
    return($lib.cast(int, $text))
}

// A response header by name, ignoring case. Returns (null) if it's missing.
function _header(headers, name) {
    $name = $name.lower()
    for ($key, $valu) in $headers {
        if ($key.lower() = $name) { return($valu) }
    }
    return()
}

// The X-Ttl header (seconds, maybe fractional) in millis, or defaultTtl if it's missing or
// not a number.
function _ttl(headers) {
    $valu = $_header($headers, "X-Ttl")
    if ($valu != null and $lib.regex.matches('^[0-9]+(\.[0-9]+)?$', $valu)) {
        $parts = $valu.split(".")
        $millis = ($_dec($parts.0) * 1000)
        if ($lib.len($parts) > 1) {
            $millis = ($millis + $_dec($parts.1.ljust(3, "0").slice(0, 3)))
        }
        return($millis)
    }
    return(($defaultTtl * 1000))
}

// The global var that holds when an endpoint's rate limit window resets (epoch millis). /json
// (45/minute) and /batch (15/minute) have their own limits.
function _rlKey(kind) {
    return(`slib:ipapi:ratelimit:{$kind}:until`)
}

// Hold every request to an endpoint on this Cortex until its rate limit window resets.
function _block(kind, millis) {
    $key = $_rlKey($kind)
    $until = ($lib.time.now() + $millis)
    $current = $lib.globals.get($key)  // noqa: R005
    if ($current = null or $until > $current) {
        $lib.globals.set($key, $until)  // noqa: R005
    }
}

// Sleep until an endpoint's rate limit window resets, if a request used it up.
function _wait(kind) {
    $until = $lib.globals.get($_rlKey($kind))  // noqa: R005
    if ($until = null) { return() }
    $delta = ($until - $lib.time.now())
    if ($delta > 0) {
        $lib.time.sleep(`{($delta / 1000)}.{$lib.cast(str, ($delta % 1000)).rjust(3, "0")}`)
    }
}

// The URL for an endpoint path (ex. "/json/8.8.8.8" or "/batch"), with the key if there is one.
function _url(path, apikey) {
    $base = $lib.globals.get("slib:ipapi:url")  // noqa: R005
    if $apikey {
        if (not $base) { $base = $proUrl }
        return(`{$base}{$path}?key={$apikey}&fields={$fields}`)
    }
    if (not $base) { $base = $freeUrl }
    return(`{$base}{$path}?fields={$fields}`)
}

// Remove an API key from text, so it never ends up in a warning.
function _scrub(text, apikey) {
    $text = $lib.cast(str, $text)
    if $apikey { $text = $text.replace($apikey, "<apikey>") }
    return($text)
}

function _fail(mesg) {
    return(({"status": (false), "mesg": $mesg, "data": (null)}))
}

// Split ip-api.com's "as" field (ex. "AS15169 Google LLC") into the result's asnum (15169, or
// (null) when the IP has no ASN) and asorg ("Google LLC", or ""). The field is renamed as_.
function _shape(data) {
    $asfield = $data."as"
    if ($asfield = null) { $asfield = "" }
    $data."as" = $lib.undef
    $data.as_ = $asfield
    $data.asnum = (null)
    $data.asorg = ""

    $m = $lib.regex.search('^AS([0-9]+)\s*(.*)$', $asfield)
    if ($m != null) {
        $data.asnum = $_dec($m.0)
        $data.asorg = $m.1.strip()
    }
    return($data)
}

// One ip-api.com result as {"status", "mesg", "data"}.
function _toRetn(ipaddr, data) {
    if ($lib.vars.type($data) != "dict" or $data.status != "success") {
        if ($lib.vars.type($data) = "dict") {
            ($status, $message) = ($data.status, $data.message)
        } else {
            ($status, $message) = ((null), $data)
        }
        return($_fail(`ip-api.com returned a {$status} status for IP address: {$ipaddr} - {$message}`))
    }
    return(({"status": (true), "mesg": `Successfully queried ip-api.com for IP address: {$ipaddr}`, "data": $_shape($data)}))
}

// Make one /json or /batch request, retrying after an HTTP 429 up to maxRetries times.
// Returns {"status", "mesg", "data"}, data is the parsed JSON body. desc describes the query
// for error messages.
//
// ip-api.com's free endpoints limit each source IP. Every response says how many requests are
// left (X-Rl) and when the window resets (X-Ttl), and when none are left every request to that
// endpoint on this Cortex waits for the reset. The pro endpoints have no limit.
function _request(kind, path, apikey, desc, body=(null)) {
    $url = $_url($path, $apikey)
    $tries = (0)
    while (true) {
        if (not $apikey) { $_wait($kind) }

        if ($body = null) {
            $resp = $lib.inet.http.get($url, timeout=$timeout)
        } else {
            $resp = $lib.inet.http.post($url, json=$body, timeout=$timeout)
        }

        if ($resp.code = 429) {
            $_block($kind, $_ttl($resp.headers))
            if ($tries >= $maxRetries) {
                return($_fail(`ip-api.com is still rate limiting requests after {$maxRetries} retries, gave up querying for {$desc}`))
            }
            $tries = ($tries + 1)
            continue
        }

        if ($resp.code = -1) {
            if ($resp.reason ~= "TimeoutError") {
                return($_fail(`Timed out after {$timeout}s querying ip-api.com for {$desc}`))
            }
            return($_fail(`An HTTP error occurred while trying to query ip-api.com for {$desc} - {$_scrub($resp.reason, $apikey)}`))
        }

        if ($resp.code != 200) {
            return($_fail(`An HTTP error occurred while trying to query ip-api.com for {$desc} - HTTP {$resp.code} {$resp.reason}`))
        }

        if (not $apikey) {
            $left = $_header($resp.headers, "X-Rl")
            if ($left != null and $lib.regex.matches('^[0-9]+$', $left) and $_dec($left) <= 0) {
                $_block($kind, $_ttl($resp.headers))
            }
        }

        try {
            $data = $resp.json()
        } catch * as err {
            return($_fail(`ip-api.com returned invalid JSON for {$desc} - {$_scrub($err.mesg, $apikey)}`))
        }

        return(({"status": (true), "mesg": "", "data": $data}))
    }
}

// Query ip-api.com for one IP address. Returns {"status", "mesg", "data"}: data is ip-api.com's
// result, with its "as" field as "as_" and parsed into "asnum" and "asorg".
// apikey is the caller's own pro key, the global key is used when it's (null).
function query(ipaddr, apikey=(null)) {
    // The global key is read here, never returned, and only sent to the fixed /json path.
    if (not $apikey) {
        $vault = $lib.vault.bytype($vaultType, scope=global)
        if ($vault and $vault.secrets) { $apikey = $vault.secrets.apikey }
    }
    $retn = $_request(json, `/json/{$ipaddr}`, $apikey, $ipaddr)
    if (not $retn.status) { return($retn) }
    return($_toRetn($ipaddr, $retn.data))
}

// Query ip-api.com for many IP addresses with its /batch endpoint, batchSize IPs per request.
// Returns {"status", "mesg", "data"}: data has one query() style result per IP, in order. A
// request that fails entirely fails each of its IPs with the request's error.
function queryBatch(ipaddrs, apikey=(null)) {
    if ($lib.vars.type($ipaddrs) != "list") {
        return($_fail("queryBatch requires a list of IP address strings"))
    }
    for $ipaddr in $ipaddrs {
        if ($lib.vars.type($ipaddr) != "str") {
            return($_fail("queryBatch requires a list of IP address strings"))
        }
    }

    // The global key is read here, never returned, and only sent to the fixed /batch path.
    if (not $apikey) {
        $vault = $lib.vault.bytype($vaultType, scope=global)
        if ($vault and $vault.secrets) { $apikey = $vault.secrets.apikey }
    }

    $retns = ([])
    $start = (0)
    $total = $lib.len($ipaddrs)
    while ($start < $total) {
        $chunk = $ipaddrs.slice($start, ($start + $batchSize))
        $desc = `{$lib.len($chunk)} IP addresses ({$chunk.0}, ...)`

        $retn = $_request(batch, "/batch", $apikey, $desc, body=$chunk)
        if ($retn.status and $lib.vars.type($retn.data) != "list") {
            $retn = $_fail(`ip-api.com's /batch returned a {$lib.vars.type($retn.data)} instead of a list for {$desc}`)
        }

        $i = (0)
        for $ipaddr in $chunk {
            if (not $retn.status) {
                $retns.append($_fail($retn.mesg))
            } elif ($i < $lib.len($retn.data)) {
                $retns.append($_toRetn($ipaddr, $retn.data.$i))
            } else {
                $retns.append($_toRetn($ipaddr, "no result in the batch response"))
            }
            $i = ($i + 1)
        }

        $start = ($start + $batchSize)
    }

    return(({"status": (true), "mesg": `Batch queried ip-api.com for {$total} IP addresses`, "data": $retns}))
}
